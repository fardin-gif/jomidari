rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // One document per game room: games/{CODE}
    match /games/{code} {
      allow read: if request.auth != null;

      // Only the creator can create the room, and they must be its host.
      allow create: if request.auth != null
                    && request.resource.data.host == request.auth.uid;

      // Host can update (start the game); afterwards only seated players can update the state.
      allow update: if request.auth != null
                    && (resource.data.host == request.auth.uid
                        || request.auth.uid in resource.data.get('uids', []))
                    && request.resource.data.host == resource.data.host;

      allow delete: if request.auth != null && resource.data.host == request.auth.uid;

      // Presence & cheers: each person writes only their own doc.
      match /presence/{uid} {
        allow read: if request.auth != null;
        allow create, update: if request.auth != null && request.auth.uid == uid;
        allow delete: if request.auth != null && (request.auth.uid == uid
                      || get(/databases/$(database)/documents/games/$(code)).data.host == request.auth.uid);
      }
      match /cheers/{uid} {
        allow read: if request.auth != null;
        allow create, update: if request.auth != null && request.auth.uid == uid;
        allow delete: if request.auth != null && (request.auth.uid == uid
                      || get(/databases/$(database)/documents/games/$(code)).data.host == request.auth.uid);
      }

      // Chat (everyone in the room): anyone signed in may write as themselves.
      match /chat/{id} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && request.resource.data.from == request.auth.uid
                      && request.resource.data.text is string && request.resource.data.text.size() <= 300;
        allow delete: if request.auth != null && (resource.data.from == request.auth.uid
                      || get(/databases/$(database)/documents/games/$(code)).data.host == request.auth.uid);
      }
      // Private messages: only the sender and chosen people (members) can read.
      match /dm/{id} {
        allow read: if request.auth != null && request.auth.uid in resource.data.members;
        allow create: if request.auth != null && request.resource.data.from == request.auth.uid
                      && request.auth.uid in request.resource.data.members
                      && request.resource.data.members.size() <= 9
                      && request.resource.data.text is string && request.resource.data.text.size() <= 300;
        allow delete: if request.auth != null && resource.data.from == request.auth.uid;
      }
      // Voice call: who is in the call, and connection handshakes (read only by the two people involved).
      match /voice/{uid} {
        allow read: if request.auth != null;
        allow create, update, delete: if request.auth != null && request.auth.uid == uid;
      }
      match /sig/{id} {
        allow read: if request.auth != null && (request.auth.uid == resource.data.to || request.auth.uid == resource.data.from);
        allow create, update: if request.auth != null && request.auth.uid == request.resource.data.from;
        allow delete: if request.auth != null && (request.auth.uid == resource.data.from || request.auth.uid == resource.data.to);
      }

      // Lobby: each person writes only their own player entry.
      match /players/{uid} {
        allow read: if request.auth != null;
        allow create, update: if request.auth != null && request.auth.uid == uid;
        allow delete: if request.auth != null && (request.auth.uid == uid
                      || get(/databases/$(database)/documents/games/$(code)).data.host == request.auth.uid);
      }
    }
  }
}
